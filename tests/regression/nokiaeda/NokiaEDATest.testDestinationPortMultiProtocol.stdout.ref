---
apiVersion: filters.eda.nokia.com/v1
kind: Filter
metadata:
  name: my-filter
  namespace: my-ns
  annotations:
    aerleon/revision: $Id:$ $Date:$ $Revision:$
spec:
  entries:
  - description: term-dport
    type: IPv4
    ipEntry:
      action: Accept
      protocolNumber: 6
      destinationPortOperator: Equals
      destinationPortNumber: 53
  - description: term-dport
    type: IPv4
    ipEntry:
      action: Accept
      protocolNumber: 17
      destinationPortOperator: Equals
      destinationPortNumber: 53

