security {
    replace: address-book {
        global {
                address ip_10.0.1.0/24 10.0.1.0/24;
                address ip_10.0.2.0/23 10.0.2.0/23;
                address ip_10.0.4.0/22 10.0.4.0/22;
                address ip_10.0.8.0/21 10.0.8.0/21;
                address-set GOOD_TERM_19_SRC_EXCLUDE {
                    address ip_10.0.1.0/24;
                    address ip_10.0.2.0/23;
                    address ip_10.0.4.0/22;
                    address ip_10.0.8.0/21;
                }
        }
    }
    /*
    $Id:$
    $Date:$
    $Revision:$
    */
    replace: policies {
        /*
        This is a test acl with a comment
        */
        from-zone trust to-zone untrust {
            policy good_term_19 {
                match {
                    source-address [ GOOD_TERM_19_SRC_EXCLUDE ];
                    destination-address any;
                    application good_term_19-app;
                }
                then {
                    permit;
                }
            }
        }
    }
}
replace: applications {
    application good_term_19-app1 {
        term t1 protocol tcp;
    }
    application-set good_term_19-app {
        application good_term_19-app1;
    }
}

