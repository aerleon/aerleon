    replace: policies {
        /*
        This is a header from untrust to trust
        */
        from-zone untrust to-zone trust {
            policy term_to_split_0 {
                match {
                    source-address [ src_term_to_split0 ];
                    destination-address [ dst_term_to_split0 ];
                    application term_to_split_0-app;
                }
                then {
                    permit;
                }
            }
            policy term_to_split_1 {
                match {
                    source-address [ src_term_to_split0 ];
                    destination-address [ dst_term_to_split1 ];
                    application term_to_split_0-app;
                }
                then {
                    permit;
                }
            }
            policy term_to_split_2 {
                match {
                    source-address [ src_term_to_split1 ];
                    destination-address [ dst_term_to_split0 ];
                    application term_to_split_0-app;
                }
                then {
                    permit;
                }
            }
            policy term_to_split_3 {
                match {
                    source-address [ src_term_to_split1 ];
                    destination-address [ dst_term_to_split1 ];
                    application term_to_split_0-app;
                }
                then {
                    permit;
                }
            }
        }
    }
}
replace: applications {
    application term_to_split_0-app1 {
        term t1 protocol tcp destination-port 25;
    }
    application-set term_to_split_0-app {
        application term_to_split_0-app1;
    }
}

