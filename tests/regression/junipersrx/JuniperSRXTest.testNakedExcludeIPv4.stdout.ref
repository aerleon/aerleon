security {
    replace: address-book {
        global {
                address ip_0.0.0.0/5 0.0.0.0/5;
                address ip_8.0.0.0/7 8.0.0.0/7;
                address ip_10.0.1.0/24 10.0.1.0/24;
                address ip_10.0.2.0/23 10.0.2.0/23;
                address ip_10.0.4.0/22 10.0.4.0/22;
                address ip_10.0.8.0/21 10.0.8.0/21;
                address ip_10.0.16.0/20 10.0.16.0/20;
                address ip_10.0.32.0/19 10.0.32.0/19;
                address ip_10.0.64.0/18 10.0.64.0/18;
                address ip_10.0.128.0/17 10.0.128.0/17;
                address ip_10.1.0.0/16 10.1.0.0/16;
                address ip_10.2.0.0/15 10.2.0.0/15;
                address ip_10.4.0.0/14 10.4.0.0/14;
                address ip_10.8.0.0/13 10.8.0.0/13;
                address ip_10.16.0.0/12 10.16.0.0/12;
                address ip_10.32.0.0/11 10.32.0.0/11;
                address ip_10.64.0.0/10 10.64.0.0/10;
                address ip_10.128.0.0/9 10.128.0.0/9;
                address ip_11.0.0.0/8 11.0.0.0/8;
                address ip_12.0.0.0/6 12.0.0.0/6;
                address ip_16.0.0.0/4 16.0.0.0/4;
                address ip_32.0.0.0/3 32.0.0.0/3;
                address ip_64.0.0.0/2 64.0.0.0/2;
                address ip_128.0.0.0/1 128.0.0.0/1;
                address-set GOOD_TERM_18_SRC_EXCLUDE {
                    address ip_0.0.0.0/5;
                    address ip_8.0.0.0/7;
                    address ip_10.0.1.0/24;
                    address ip_10.0.2.0/23;
                    address ip_10.0.4.0/22;
                    address ip_10.0.8.0/21;
                    address ip_10.0.16.0/20;
                    address ip_10.0.32.0/19;
                    address ip_10.0.64.0/18;
                    address ip_10.0.128.0/17;
                    address ip_10.1.0.0/16;
                    address ip_10.2.0.0/15;
                    address ip_10.4.0.0/14;
                    address ip_10.8.0.0/13;
                    address ip_10.16.0.0/12;
                    address ip_10.32.0.0/11;
                    address ip_10.64.0.0/10;
                    address ip_10.128.0.0/9;
                    address ip_11.0.0.0/8;
                    address ip_12.0.0.0/6;
                    address ip_16.0.0.0/4;
                    address ip_32.0.0.0/3;
                    address ip_64.0.0.0/2;
                    address ip_128.0.0.0/1;
                }
        }
    }
    /*
    $Id:$
    $Date:$
    $Revision:$
    */
    replace: policies {
        /*
        This is a test acl with a comment
        */
        from-zone trust to-zone untrust {
            policy good_term_18 {
                match {
                    source-address [ GOOD_TERM_18_SRC_EXCLUDE ];
                    destination-address any;
                    application good_term_18-app;
                }
                then {
                    permit;
                }
            }
        }
    }
}
replace: applications {
    application good_term_18-app1 {
        term t1 protocol tcp;
    }
    application-set good_term_18-app {
        application good_term_18-app1;
    }
}

