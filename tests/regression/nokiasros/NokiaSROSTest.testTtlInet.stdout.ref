[
    {
        "ip-filter": {
            "nokia-conf:scope": "template",
            "nokia-conf:type": "packet-length",
            "nokia-conf:default-action": "drop",
            "nokia-conf:filter-name": "my-filter",
            "nokia-conf:entry": [
                {
                    "description": "term-ttl",
                    "action": {
                        "drop": [
                            null
                        ]
                    },
                    "match": {
                        "ttl": {
                            "eq": 5
                        }
                    },
                    "entry-id": 1000
                }
            ]
        }
    }
]

